diff --git a/src/hev-socks5-tunnel.c b/src/hev-socks5-tunnel.c
index d025c6f..219d65c 100644
--- a/src/hev-socks5-tunnel.c
+++ b/src/hev-socks5-tunnel.c
@@ -59,6 +59,30 @@ static HevTask *task_event;
 static HevTask *task_lwip_io;
 static HevTask *task_lwip_timer;
 static HevList session_set;
+static HevDnsRouteCallback dns_route_callback;
+
+void
+hev_socks5_tunnel_set_dns_route_callback (HevDnsRouteCallback callback)
+{
+    dns_route_callback = callback;
+}
+
+int
+hev_socks5_tunnel_dns_relay_port (int protocol, const ip_addr_t *source,
+                                  int source_port, const ip_addr_t *destination,
+                                  int destination_port)
+{
+    char source_text[IPADDR_STRLEN_MAX];
+    char destination_text[IPADDR_STRLEN_MAX];
+
+    if (destination_port != 53 || !dns_route_callback)
+        return 0;
+    if (!ipaddr_ntoa_r (source, source_text, sizeof (source_text)) ||
+        !ipaddr_ntoa_r (destination, destination_text, sizeof (destination_text)))
+        return 0;
+    return dns_route_callback (protocol, source_text, source_port,
+                               destination_text, destination_port);
+}
 
 static int
 task_io_yielder (HevTaskYieldType type, void *data)
